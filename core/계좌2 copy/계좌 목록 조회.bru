meta {
  name: 계좌 목록 조회
  type: http
  seq: 1
}

get {
  url: {{coreBaseUrl}}/users/{{app_user_id}}/accounts?status={{account_status}}
  body: none
  auth: none
}

headers {
  @description('인증 토큰 (Bearer)')
  Authorization: Bearer {{authToken}}
}

docs {
  output: accountNo=계좌번호, name=계좌명, accountType=계좌 유형, status=상태, openedAt=개설일, closedAt=폐쇄일, owner.name=소유자명, owner.cif=소유자 CIF, balance.amount=잔액, balance.currency=통화, tags=태그
}
