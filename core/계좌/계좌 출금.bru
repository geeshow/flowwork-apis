meta {
  name: 계좌 출금
  type: http
  seq: 4
}

post {
  url: {{coreBaseUrl}}/accounts/{{accountNo}}/withdraw
  body: json
  auth: none
}

headers {
  @description("인증 토큰 (Bearer)")
  Authorization: Bearer {{authToken}}
  @description("요청 본문 형식")
  Content-Type: application/json
}

body:json {
  {"amount": {{amount}}, "password": "{{password}}"}
}

docs {
  output: accountNo=계좌번호, status=상태, withdrawnAmount=출금액, balanceAfter=출금 후 잔액, reason=사유
}
