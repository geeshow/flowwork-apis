meta {
  name: 사용자 정보 조회
  type: http
  seq: 1
}

get {
  url: {{coreBaseUrl}}/users?sec_user_id={{sec_user_id}}&cif={{CIF}}
  body: none
  auth: none
}

headers {
  @description("인증 토큰 (Bearer)")
  Authorization: Bearer {{authToken}}
}

docs {
  output: app_user_id=앱 사용자 ID, sec_user_id=보안 사용자 ID, CIF=고객식별번호, name=이름, phone=전화번호, email=이메일
}
