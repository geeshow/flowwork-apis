{
  "id": "demo_repeat",
  "domain": "데모",
  "task": "목록반복",
  "name": "목록 반복형 — 계좌마다 같은 처리",
  "description": "계좌 목록을 반복 블록으로 돌면서 계좌마다 소유자를 확인하고, 호출 사이에 간격을 둡니다.",
  "docs": "목록 하나를 받아 **항목마다 같은 처리**를 반복하는 형태입니다.\n\n```\n계좌 목록의 목록마다        ← 반복 블록\n  3-1 계좌 소유자 확인\n  3-2 0.5초 대기\n```\n\n- 반복 블록 안의 스텝은 회차마다 그 회차 항목(`반복 항목`)을 입력으로 쓸 수 있습니다.\n- 반복이 끝나면 안쪽 스텝의 응답은 **회차별 배열**로 남아 뒤 스텝에서 참조할 수 있습니다.\n- 사이에 둔 대기는 상대 시스템을 몰아치지 않으려는 간격입니다.\n\n`U1000`으로 실행하면 계좌 2건에 대해 2회 돕니다.",
  "baseInputs": [
    {
      "kind": "MANUAL",
      "key": "app_user_id",
      "label": "앱 사용자 ID",
      "valueType": "string"
    }
  ],
  "steps": [
    {
      "id": "lookup_user",
      "order": 1,
      "name": "사용자 정보 조회 (앱ID)",
      "apiBinding": {
        "catalogEntry": {
          "department": "core",
          "collectionFile": "core",
          "itemPath": [
            "사용자"
          ],
          "name": "사용자 정보 조회 (앱ID)"
        },
        "variableBindings": {
          "app_user_id": {
            "kind": "USER_INPUT",
            "inputKey": "app_user_id"
          }
        }
      },
      "parallel": false,
      "stopOnFailure": true,
      "resultView": {
        "mode": "TABLE",
        "columns": [
          "name",
          "sec_user_id",
          "CIF"
        ]
      }
    },
    {
      "id": "list_accounts",
      "order": 2,
      "name": "계좌 목록 조회 (보안ID)",
      "apiBinding": {
        "catalogEntry": {
          "department": "core",
          "collectionFile": "core",
          "itemPath": [
            "계좌"
          ],
          "name": "계좌 목록 조회 (보안ID)"
        },
        "variableBindings": {
          "sec_user_id": {
            "kind": "PREV_RESPONSE",
            "stepId": "lookup_user",
            "jsonPath": "$.data.sec_user_id"
          }
        }
      },
      "parallel": false,
      "stopOnFailure": true,
      "resultView": {
        "mode": "TABLE",
        "columns": [
          "accountNo",
          "accountType",
          "status",
          "owner.cif"
        ]
      }
    },
    {
      "id": "each_account",
      "order": 3,
      "name": "계좌마다",
      "kind": "REPEAT",
      "repeat": {
        "kind": "LIST",
        "sourceStepId": "list_accounts",
        "itemsPath": "$.data",
        "maxIterations": 10
      },
      "parallel": false,
      "stopOnFailure": false
    },
    {
      "id": "owner",
      "order": 4,
      "name": "계좌 소유자 확인",
      "parentId": "each_account",
      "apiBinding": {
        "catalogEntry": {
          "department": "core",
          "collectionFile": "core",
          "itemPath": [
            "사용자"
          ],
          "name": "사용자 정보 조회"
        },
        "variableBindings": {
          "sec_user_id": {
            "kind": "FIXED",
            "value": ""
          },
          "CIF": {
            "kind": "LOOP_ITEM",
            "itemPath": "$.owner.cif"
          }
        }
      },
      "parallel": false,
      "stopOnFailure": false,
      "resultView": {
        "mode": "TABLE",
        "columns": [
          "name",
          "sec_user_id",
          "CIF",
          "phone"
        ]
      }
    },
    {
      "id": "pace",
      "order": 5,
      "name": "0.5초 대기",
      "parentId": "each_account",
      "delayBinding": {
        "seconds": 0.5
      },
      "parallel": false,
      "stopOnFailure": false
    }
  ]
}