{
  "id": "demo_midinput",
  "domain": "데모",
  "task": "중간확인",
  "name": "중간 확인형 — 조회 결과를 보고 사람이 고르기",
  "description": "계좌 목록을 먼저 보여주고, 그 표에서 계좌와 사유를 고른 뒤 폐쇄를 진행합니다.",
  "docs": "시작할 때 모든 값을 받을 수 없고, **중간 결과를 보고 나서야** 정할 수 있는 작업 형태입니다.\n\n1. 계좌 목록을 조회해 표로 보여줍니다.\n2. 그 표의 계좌 중 하나와 폐쇄 사유를 **중간 입력**으로 받습니다.\n3. 고른 계좌를 폐쇄합니다.\n\n중간 입력은 앞 스텝이 성공한 뒤에만 뜨고, 받은 값은 그 뒤 스텝에서 입력값처럼 쓸 수 있습니다.\n데모 서버는 상태를 실제로 바꾸지 않으니 몇 번을 실행해도 안전합니다.",
  "baseInputs": [
    {
      "kind": "MANUAL",
      "key": "app_user_id",
      "label": "앱 사용자 ID",
      "valueType": "string"
    },
    {
      "kind": "DEPENDENT_LOOKUP",
      "key": "sec_user_id",
      "label": "보안 사용자 ID",
      "dependsOnKey": "app_user_id",
      "lookupApiId": "11c8a795c396e2b4",
      "displayFields": [
        "name",
        "sec_user_id"
      ],
      "valueField": "sec_user_id"
    }
  ],
  "steps": [
    {
      "id": "list_accounts",
      "order": 1,
      "name": "계좌 목록 조회 (보안ID)",
      "apiBinding": {
        "catalogEntry": {
          "department": "core",
          "collectionFile": "core",
          "itemPath": [
            "계좌"
          ],
          "name": "계좌 목록 조회 (보안ID)"
        },
        "variableBindings": {
          "sec_user_id": {
            "kind": "USER_INPUT",
            "inputKey": "sec_user_id"
          }
        }
      },
      "parallel": false,
      "stopOnFailure": true,
      "resultView": {
        "mode": "TABLE",
        "columns": [
          "accountNo",
          "accountType",
          "status",
          "balance.amount"
        ]
      },
      "midInputs": [
        {
          "kind": "STEP_RESULT_COMBO",
          "key": "accountNo",
          "label": "폐쇄할 계좌",
          "arrayPath": "",
          "labelField": "accountType",
          "valueField": "accountNo"
        },
        {
          "kind": "MANUAL",
          "key": "close_reason",
          "label": "폐쇄 사유",
          "valueType": "string"
        }
      ]
    },
    {
      "id": "close",
      "order": 2,
      "name": "계좌 폐쇄",
      "apiBinding": {
        "catalogEntry": {
          "department": "core",
          "collectionFile": "core",
          "itemPath": [
            "계좌"
          ],
          "name": "계좌 폐쇄"
        },
        "variableBindings": {
          "accountNo": {
            "kind": "USER_INPUT",
            "inputKey": "accountNo"
          },
          "reason": {
            "kind": "USER_INPUT",
            "inputKey": "close_reason"
          }
        }
      },
      "parallel": false,
      "stopOnFailure": false,
      "resultView": {
        "mode": "TABLE",
        "columns": [
          "accountNo",
          "status",
          "closedAt",
          "reason"
        ]
      }
    }
  ]
}