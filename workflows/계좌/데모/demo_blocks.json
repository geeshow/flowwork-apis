{
  "id": "demo_blocks",
  "domain": "계좌",
  "task": "데모",
  "name": "블록 데모 (반복 블록 안 분기 블록)",
  "description": "계좌 목록을 반복 블록으로 돌면서, 활성 계좌인 회차에만 분기 블록 안의 스텝들이 실행됩니다.",
  "docs": "반복·분기를 **블록**으로 짠 예시입니다.\n\n```\n계좌 목록의 목록마다              ← 반복 블록\n  반복 항목의 status = ACTIVE 일 때만   ← 분기 블록\n    3-1 소유자 확인\n    3-2 1초 대기\n```\n\nU1000으로 실행하면 계좌 2건 중 ACTIVE 1건에서만 블록 안 두 스텝이 돕니다.",
  "baseInputs": [
    {
      "kind": "MANUAL",
      "key": "app_user_id",
      "label": "앱 사용자 ID",
      "valueType": "string"
    }
  ],
  "steps": [
    {
      "id": "lookup_user",
      "order": 1,
      "name": "사용자 정보 조회 (앱ID)",
      "apiBinding": {
        "catalogEntry": {
          "department": "core",
          "collectionFile": "core",
          "itemPath": [
            "사용자"
          ],
          "name": "사용자 정보 조회 (앱ID)"
        },
        "variableBindings": {
          "app_user_id": {
            "kind": "USER_INPUT",
            "inputKey": "app_user_id"
          }
        }
      },
      "parallel": false,
      "stopOnFailure": true,
      "resultView": {
        "mode": "TABLE",
        "columns": [
          "name",
          "sec_user_id",
          "CIF"
        ]
      }
    },
    {
      "id": "list_accounts",
      "order": 2,
      "name": "계좌 목록 조회 (보안ID)",
      "apiBinding": {
        "catalogEntry": {
          "department": "core",
          "collectionFile": "core",
          "itemPath": [
            "계좌"
          ],
          "name": "계좌 목록 조회 (보안ID)"
        },
        "variableBindings": {
          "sec_user_id": {
            "kind": "PREV_RESPONSE",
            "stepId": "lookup_user",
            "jsonPath": "$.data.sec_user_id"
          }
        }
      },
      "parallel": false,
      "stopOnFailure": true,
      "resultView": {
        "mode": "TABLE",
        "columns": [
          "accountNo",
          "accountType",
          "status",
          "owner.cif"
        ]
      }
    },
    {
      "id": "each_account",
      "order": 3,
      "name": "계좌마다",
      "repeat": {
        "kind": "LIST",
        "sourceStepId": "list_accounts",
        "itemsPath": "$.data",
        "maxIterations": 10
      },
      "parallel": false,
      "stopOnFailure": false
    },
    {
      "id": "if_active",
      "order": 4,
      "name": "활성 계좌일 때",
      "parallel": false,
      "branchCondition": {
        "source": {
          "kind": "LOOP_ITEM",
          "itemPath": "$.status"
        },
        "operator": "EQ",
        "compareValue": "ACTIVE"
      },
      "stopOnFailure": false
    },
    {
      "id": "check_owner",
      "order": 5,
      "name": "소유자 확인",
      "apiBinding": {
        "catalogEntry": {
          "department": "core",
          "collectionFile": "core",
          "itemPath": [
            "사용자"
          ],
          "name": "사용자 정보 조회"
        },
        "variableBindings": {
          "sec_user_id": {
            "kind": "FIXED",
            "value": ""
          },
          "CIF": {
            "kind": "LOOP_ITEM",
            "itemPath": "$.owner.cif"
          }
        }
      },
      "parallel": false,
      "stopOnFailure": false,
      "resultView": {
        "mode": "TABLE",
        "columns": [
          "name",
          "sec_user_id",
          "CIF",
          "phone"
        ]
      }
    },
    {
      "id": "cool_down",
      "order": 6,
      "name": "1초 대기",
      "delayBinding": {
        "seconds": 1
      },
      "parallel": false,
      "stopOnFailure": false
    }
  ]
}