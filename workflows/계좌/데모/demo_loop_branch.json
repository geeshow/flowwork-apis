{
  "id": "demo_loop_branch",
  "domain": "계좌",
  "task": "데모",
  "name": "반복 속 분기 데모 (활성 계좌만)",
  "description": "계좌 목록을 돌면서 활성(ACTIVE) 계좌인 회차만 소유자를 확인합니다.",
  "docs": "반복 안에 분기 조건이 들어간 예시입니다.\n\n1. 사용자 정보 조회로 보안 사용자 ID를 얻습니다.\n2. 그 ID로 계좌 목록을 조회합니다.\n3. 계좌마다 한 번씩 돌면서, **그 회차의 계좌 상태가 ACTIVE일 때만** 소유자(CIF)로 사용자 정보를 확인합니다.\n\n조건에 맞지 않는 회차는 호출하지 않고 건너뛰며, 실행 화면에 \"건너뜀\" 수로 표시됩니다.\nU1000으로 실행하면 계좌 2건 중 ACTIVE 1건만 호출됩니다.",
  "baseInputs": [
    {
      "kind": "MANUAL",
      "key": "app_user_id",
      "label": "앱 사용자 ID",
      "valueType": "string"
    }
  ],
  "steps": [
    {
      "id": "lookup_user",
      "order": 1,
      "name": "사용자 정보 조회 (앱ID)",
      "apiBinding": {
        "catalogEntry": {
          "department": "core",
          "collectionFile": "core",
          "itemPath": [
            "사용자"
          ],
          "name": "사용자 정보 조회 (앱ID)"
        },
        "variableBindings": {
          "app_user_id": {
            "kind": "USER_INPUT",
            "inputKey": "app_user_id"
          }
        }
      },
      "parallel": false,
      "stopOnFailure": true,
      "resultView": {
        "mode": "TABLE",
        "columns": [
          "name",
          "sec_user_id",
          "CIF"
        ]
      }
    },
    {
      "id": "list_accounts",
      "order": 2,
      "name": "계좌 목록 조회 (보안ID)",
      "apiBinding": {
        "catalogEntry": {
          "department": "core",
          "collectionFile": "core",
          "itemPath": [
            "계좌"
          ],
          "name": "계좌 목록 조회 (보안ID)"
        },
        "variableBindings": {
          "sec_user_id": {
            "kind": "PREV_RESPONSE",
            "stepId": "lookup_user",
            "jsonPath": "$.data.sec_user_id"
          }
        }
      },
      "parallel": false,
      "stopOnFailure": true,
      "resultView": {
        "mode": "TABLE",
        "columns": [
          "accountNo",
          "accountType",
          "status",
          "owner.cif"
        ]
      }
    },
    {
      "id": "check_active_owner",
      "order": 3,
      "name": "활성 계좌 소유자 확인",
      "apiBinding": {
        "catalogEntry": {
          "department": "core",
          "collectionFile": "core",
          "itemPath": [
            "사용자"
          ],
          "name": "사용자 정보 조회"
        },
        "variableBindings": {
          "sec_user_id": {
            "kind": "FIXED",
            "value": ""
          },
          "CIF": {
            "kind": "LOOP_ITEM",
            "itemPath": "$.owner.cif"
          }
        }
      },
      "repeat": {
        "kind": "LIST",
        "sourceStepId": "list_accounts",
        "itemsPath": "$.data",
        "maxIterations": 10
      },
      "parallel": false,
      "branchCondition": {
        "source": {
          "kind": "LOOP_ITEM",
          "itemPath": "$.status"
        },
        "operator": "EQ",
        "compareValue": "ACTIVE"
      },
      "stopOnFailure": false,
      "resultView": {
        "mode": "TABLE",
        "columns": [
          "name",
          "sec_user_id",
          "CIF",
          "phone"
        ]
      }
    }
  ]
}