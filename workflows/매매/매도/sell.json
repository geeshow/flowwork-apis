{
  "id": "sell",
  "domain": "매매",
  "task": "매도",
  "name": "매도",
  "description": "계좌번호와 비밀번호로 보유 포지션을 전량 매도한다.",
  "baseInputs": [
    {
      "kind": "MANUAL",
