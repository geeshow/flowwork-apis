          },
          "password": {
            "kind": "USER_INPUT",
            "inputKey": "password"
          }
        }
      },
      "stopOnFailure": true,
      "resultView": {
        "mode": "TABLE",
        "columns": [
          "accountNo",
          "status",
          "soldAmount",
          "positions"
        ]
      }
